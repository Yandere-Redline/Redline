  "cgFrame": { "aspect": "16:9", "offsetY": "-34%" },

  "steps": [
    { "t": "盲目の魔物" },
    { "t": "いらっしゃい、道に迷ったの？\n寒かったでしょう…"},
    { "t": "ここは一年中雪が降るの\n不思議な場所よね"},
    { "t": "この吹雪の中はもう移動しないほうがいい"},
    { "t": "今晩は私の宿に泊まっていくでしょう？"},
    { "t": "おいでこっちに歓迎します"}
  ],

  "choices": [
    { "label": "断る", "to": "normal001" },
    { "label": "一晩だけ",       "to": "yandere001" },
    { "label": "雪が止むまで",       "to": "bad001" }
  ],

  "nodes": {
    "normal001": {
      "kind": "normal",
      "cgRef": "cg.ep003.1normal",
      "steps": [
      { "t": "あなたはもう…\nあっちの世界には帰さない…"},
      { "t": "あんまりこういうことは\nしたく無かったんだけど…"},
      { "t": "洗脳って言うのかな？"},
      { "t": "聞き分けの悪い子には、"},
      { "t": "今のうちからしっかり教育してあげないとね？"}   
      ],
      "end": true
    },


    "yandere001": {
      "kind": "yandere",
      "cgRef": "cg.ep003.2yandere",
      "steps": [
        { "t": "ここは時の狭間\n同じ時間で留まり続ける２人だけの世界" },
        { "t": "私とあなたは永遠に初対面" },
        { "t": "旅館の女将と迷い込んだお客様\nという関係を続けましょう？" },
        { "t": "毎日毎日毎日\n許されない愛を味わい続けましょう？" },
        { "t": "私たちはもう、戻らないんだから…" }
      ],
      "end": true
    },

    "bad001": {
      "kind": "bad",
      "cgRef": "cg.ep003.3bad",
      "steps": [
        { "t": "お風呂とご飯の準備が出来ましたよ～\nおいで～" },
        { "t": "あっ、ちょっと！\nここではメッ！！でしょ？" },
        { "t": "すこし目が効きすぎちゃったかな？" },
        { "t": "永遠に赤ちゃんで居たいなんて…\n本当に可愛い子ね…" },
        { "t": "これから一生、\nいい子いい子してあげまちゅからね～" },
        { "t": "可愛い可愛い…私のあかちゃん♪" }
      ],
      "end": true
    }
  }



