      "end": true
    },


    "yandere001": {
      "kind": "yandere",
      "cgRef": "CG.ep005.2yandere",
      "steps": [
        { "t": "頭が高いんじゃないんですか？" },
        { "t": "ひざまずいてしっかりお願いしないと\n見せてあげませんよ？" },
        { "t": "先輩、犬みたいで可愛いー！" },
        { "t": "たっぷり夢の中でいじめてあげますよ" },
        { "t": "夢の中では誰も見ていませんから\n存分に乱れてください" },
        { "t": "二人だけの世界で、愛し合いましょう…" }
      ],
      "end": true
    },

    "bad001": {
      "kind": "bad",
      "cgRef": "PR.ep005.3bad",
      "steps": [
        { "t": "「愛し方を知らなかったサキュバスが\n純愛を知って改心する…」", "voiceRef": "PRvo.ep05.bad.001" },
        { "t": "だったら一生、そういう女でいてあげますよ！" , "voiceRef": "PRvo.ep05.bad.002"},
        { "t": "このゲームは私の勝ち…", "voiceRef": "PRvo.ep05.bad.003" },
        { "t": "キャハハハハハ！", "voiceRef": "PRvo.ep05.bad.004" }
      ],
      "end": true
    }
