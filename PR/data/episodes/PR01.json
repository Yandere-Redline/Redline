  "steps": [
    { "t": "魔物狩りの剣士" },
    { "t": "そこのお姉さん…\nその男から離れてくれない？" , "voiceRef": "PRvo.ep01.001"},
    { "t": "そいつ、私の彼氏なんだよね。" , "voiceRef": "PRvo.ep01.002"},
    { "t": "ちょっと離れててね\nすぐにそいつ消すから…" , "voiceRef": "PRvo.ep01.003" }
  ],

  "choices": [
    { "label": "引き留める", "to": "normal001" },
        { "label": "逃げる",       "to": "bad001" },
    { "label": "黙って見過ごす",       "to": "yandere001" }

  ],

  "nodes": {
    "normal001": {
      "kind": "normal",
      "cgRef": "cg.ep001.1normal",
      "steps": [
        { "t": "殺さなくても、話せばわかる？フフフ" },
        { "t": "おかしなこと言わないでよ\n魔物に話なんか通じない" },
        { "t": "そもそも君を誘拐しようとしたやつなんて、" },
        { "t": "問題無用で消えてもらわないとね" },
        { "t": "今の私に近寄らないほうがいいよ？" },
        { "t": "ブちぎれてるからさ！！！" }
      ],
      "end": true
    },


    "yandere001": {
      "kind": "yandere",
      "cgRef": "cg.ep001.2yandere",
      "steps": [
        { "t": "どう、見ててくれた？私の格好良いところ！" },
        { "t": "ご褒美のキース" },
        { "t": "フフフ今から首をはねるね" },
        { "t": "今更、命乞いしてんじゃねーよ\nお前は私の大切な人を傷つけた" },
        { "t": "死ね" }
      ],
      "end": true
    },

    "bad001": {
      "kind": "bad",
      "cgRef": "PR.ep001.3bad",
      "steps": [
        { "t": "さて…お仕置きの時間だね…" , "voiceRef": "PRvo.ep01.bad.001"},
        { "t": "私から逃げられると思った？\n答えろよ" , "voiceRef": "PRvo.ep01.bad.002"},
        { "t": "あんたがこの女と協力して逃げようとしたとしか\n考えられないんだよ…", "voiceRef": "PRvo.ep01.bad.003" },
        { "t": "どこにも行かないでね…" , "voiceRef": "PRvo.ep01.bad.004"}
      ],
      "end": true
    }


