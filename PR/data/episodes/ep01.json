{
  "id": "ep01",
  "backgroundRef": "bg.main",
  "mainCgRef": "cg.ep001.0main",
  "cgFrame": { "aspect": "16:9", "offsetY": "-34%" },

  "steps": [
    { "t": "赤い刀の剣士" },
    { "t": "お姉さん、\nその男から離れてくれない？"},
    { "t": "そいつ、私の彼氏なんだよね。"},
    { "t": "ごめんね、遅くなった！" },
    { "t": "大丈夫？怪我は無い？" },
    { "t": "ちょっと離れててね\nすぐにそいつ消すから！" }
  ],

  "choices": [
    { "label": "引き留める", "to": "normal001" },
    { "label": "黙って見過ごす",       "to": "yandere001" },
    { "label": "逃げる",       "to": "bad001" }
  ],

  "nodes": {
    "normal001": {
      "kind": "normal",
      "cgRef": "cg.ep001.1normal",
      "steps": [
        { "t": "殺さなくても、話せばわかる？フフフ" },
        { "t": "おかしなこと言わないでよ\n魔物に話なんか通じない" },
        { "t": "そもそも君を誘拐しようとしたやつなんて、" },
        { "t": "問題無用で消えてもらわないとね" },
        { "t": "今の私に近寄らないほうがいいよ？" },
        { "t": "ブちぎれてるからさ！！！" }
      ],
      "end": true
    },


    "yandere001": {
      "kind": "yandere",
      "cgRef": "cg.ep001.2yandere",
      "steps": [
        { "t": "どう、見ててくれた？私の格好良いところ！" },
        { "t": "ご褒美のキース" },
        { "t": "フフフ今から首をはねるね" },
        { "t": "今更、命乞いしてんじゃねーよ\nお前は私の大切な人を傷つけた" },
        { "t": "死ね" }
      ],
      "end": true
    },

    "bad001": {
      "kind": "bad",
      "cgRef": "cg.ep001.3bad",
      "steps": [
        { "t": "さて、お仕置きの時間だね！" },
        { "t": "私から逃げられると思った？答えろよ" },
        { "t": "あんたがこの女と協力して\n逃げようとしたとしか考えられないんだよ…" },
        { "t": "次はねーからな?" },
        { "t": "手足ぶった切ってでも\n逃げられないようにするぞ？" },
        { "t": "どこにも行かないでね…" }
      ],
      "end": true
    }


  }
}