      "kind": "normal",
      "cgRef": "cg.ep004.1normal",
      "steps": [
      { "t": "見て下さい！\n海ですよ！行きましょう！"},
      { "t": "きゃ！もう！\n辞めてください、冷たいですよ！"},
      { "t": "すいません、その…"},
      { "t": "服が透けてしまって…下着が…"},
      { "t": "…いいですよ、見ても"},
      { "t": "「夢の中だから」じゃありません"},
      { "t": "「あなただから」いいんです"}   
      ],
      "end": true
    },


    "yandere001": {
      "kind": "yandere",
      "cgRef": "cg.ep004.2yandere",
