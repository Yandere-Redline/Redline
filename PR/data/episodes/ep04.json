    { "t": "あなたが想像し私が創る世界"},
    { "t": "どこか行きたい場所はありますか？\n何か食べたいものはありますか？"},
    { "t": "あなたのお望みを\n私が何でも叶えて差し上げます"},
    { "t": "何か見たい夢はありますか？"}
  ],

  "choices": [
    { "label": "青春の初デート", "to": "normal001" },
    { "label": "普通のデート",       "to": "yandere001" },
