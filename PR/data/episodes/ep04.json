        { "t": "記憶や思い出を消すんです。\nだってもう必要無いですもんね" },
        { "t": "堕ちましょう…２人で…" },
        { "t": "永遠に続く夢の世界で縛られましょう？" },
        { "t": "私達はもう…戻らないのですから" }
