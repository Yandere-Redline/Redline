        { "t": "私、キスするの初めてです" },
        { "t": "もっとして欲しいって思うのは\nいけないことでしょうか？" },
        { "t": "してください…もっと…" }
      ],
      "end": true
    },

    "bad001": {
      "kind": "bad",
      "cgRef": "cg.ep004.3bad",
