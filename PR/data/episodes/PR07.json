    { "t": "はぁ…まだ別れてないんですか？","voiceRef": "PRvo.ep07.002"},
    { "t": "いつになったら別れてくれるんですか？","voiceRef": "PRvo.ep07.003"}
  ],

  "choices": [
    { "label": "今すぐに", "to": "normal001" },
