      "end": true
    },


    "yandere001": {
      "kind": "yandere",
      "cgRef": "PR.ep007.2yandere",
      "steps": [
        { "t": "頭が高いんじゃないんですか？" },
        { "t": "ひざまずいてしっかりお願いしないと\n見せてあげませんよ？" },
        { "t": "先輩、犬みたいで可愛いー！" },
        { "t": "たっぷり夢の中でいじめてあげますよ" },
        { "t": "夢の中では誰も見ていませんから\n存分に乱れてください" },
        { "t": "二人だけの世界で、愛し合いましょう…" }
      ],
      "end": true
    },

    "bad001": {
      "kind": "bad",
      "cgRef": "PR.ep007.3bad",
      "steps": [
        { "t": "責任とれって言ってんだよ…" , "voiceRef": "PRvo.ep07.bad.001"},
        { "t": "このまま先輩に任せてても埒が明かないので…", "voiceRef": "PRvo.ep07.bad.002" },
        { "t": "先輩を閉じ込めることにしました。", "voiceRef": "PRvo.ep07.bad.003" },
        { "t": "ここは私がつくった物語の世界…", "voiceRef": "PRvo.ep07.bad.004" },
        { "t": "記憶を消してもう一度…\n最初からやり直しましょう", "voiceRef": "PRvo.ep07.bad.005" },
