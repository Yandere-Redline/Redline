  ],

  "nodes": {
    "normal001": {
      "kind": "normal",
      "cgRef": "cg.ep003.1normal",
      "steps": [
      { "t": "あなたはもう…\nあっちの世界には帰さない…"},
      { "t": "あんまりこういうことは\nしたく無かったんだけど…"},
      { "t": "洗脳って言うのかな？"},
      { "t": "聞き分けの悪い子には、"},
      { "t": "今のうちからしっかり教育してあげないとね？"}   
      ],
      "end": true
    },


    "yandere001": {
      "kind": "yandere",
      "cgRef": "cg.ep003.2yandere",
      "steps": [
        { "t": "ここは時の狭間\n同じ時間で留まり続ける２人だけの世界" },
        { "t": "私とあなたは永遠に初対面" },
        { "t": "旅館の女将と迷い込んだお客様\nという関係を続けましょう？" },
        { "t": "毎日毎日毎日\n許されない愛を味わい続けましょう？" },
        { "t": "私たちはもう、戻らないんだから…" }
      ],
      "end": true
    },

    "bad001": {
      "kind": "bad",
      "cgRef": "PR.ep003.3bad",
      "steps": [
          { "t": "彼女がいるって言ってたよね…\nそんな女のことなんか…忘れさせてあげる", "voiceRef": "PRvo.ep03.bad.001" },
          { "t": "拒まれたら余計にたぎっちゃう…" , "voiceRef": "PRvo.ep03.bad.002"},
          { "t": "この目はあなたを逃がさない…" , "voiceRef": "PRvo.ep03.bad.003"}
      ],
      "end": true
