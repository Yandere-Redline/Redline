    { "t": "盲目の魔物" },
    { "t": "ここは一年中雪が降るの…\n不思議な場所よね","voiceRef": "PRvo.ep03.001"},
    { "t": "今晩は、私の宿に泊まっていくでしょう？","voiceRef": "PRvo.ep03.002"}
  ],

  "choices": [
    { "label": "断る", "to": "normal001" },
        { "label": "雪が止むまで",       "to": "bad001" },
